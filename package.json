{
  "name": "qubic-typescript",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "generate": "bun run --filter '*' generate",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test --recursive --coverage",
    "lint": "bunx biome check --write .",
    "ci:lint": "bunx biome ci .",
    "clean": "find . -name dist -not -path '*/node_modules/*' -exec rm -rf {} +",
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "release": "bun run build && changeset publish --no-provenance",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "commit-msg": "bunx --bun commitlint --edit $1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.10",
    "@commitlint/config-conventional": "^19.6.0",
    "bun-types": "^1.3.13",
    "commitlint": "^19.6.0",
    "simple-git-hooks": "^2.11.1",
    "typedoc": "^0.28.0",
    "typescript": "^5.7.0"
  }
}
