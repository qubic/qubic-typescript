{
  "name": "@qubic.org/rpc",
  "version": "1.0.0",
  "license": "Anti-Military",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "generate": "openapi-typescript ../../resources/live-api.json -o src/live-schema.d.ts && openapi-typescript ../../resources/query-api.json -o src/query-schema.d.ts",
    "build": "tsc -p tsconfig.json && cp src/live-schema.d.ts dist/live-schema.d.ts && cp src/query-schema.d.ts dist/query-schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@qubic.org/types": "^1.0.0",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "*"
  }
}
