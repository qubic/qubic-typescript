{
  "name": "@qubic.org/registry",
  "version": "0.2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "bun": "./src/client.ts",
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./registry.json": "./data/registry.json",
    "./schema.json": "./data/schema.json"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "validate": "bun scripts/validate.ts",
    "backfill": "bun scripts/backfill.ts",
    "extract-abi": "bun scripts/extract-abi.ts"
  },
  "dependencies": {
    "@qubic.org/crypto": "workspace:^",
    "@qubic.org/types": "workspace:^",
    "tree-sitter-cpp": "^0.23.4",
    "web-tree-sitter": "^0.26.8"
  },
  "devDependencies": {
    "typescript": "*"
  }
}
